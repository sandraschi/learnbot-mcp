# chatbot-mcp configuration

# Regulatory regime: none, china, eu
CHATBOT_REGULATORY_REGIME=none
CHATBOT_REAL_NAME_AUTH=false
CHATBOT_RETENTION_DAYS=90

# LLM backend (local-llm-mcp)
CHATBOT_LLM_BASE_URL=http://127.0.0.1:10832
CHATBOT_LLM_MODEL=

# Fleet MCP server URLs
CHATBOT_SPEECH_MCP_URL=http://127.0.0.1:10909
CHATBOT_AVATAR_MCP_URL=http://127.0.0.1:10792
CHATBOT_RESONITE_MCP_URL=http://127.0.0.1:10978
CHATBOT_MEMOPS_URL=http://127.0.0.1:10732

# Safety
CHATBOT_RATE_LIMIT=30

# API key (optional, for REST auth)
CHATBOT_API_KEY=

# Ports
BACKEND_PORT=11101
FRONTEND_PORT=11102
