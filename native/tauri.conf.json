{
    "productName": "LearnBot MCP",
    "version": "0.5.0",
    "identifier": "ai.fleet.learnbot-mcp",
    "build": {
        "frontendDist": "../webapp/dist",
        "devUrl": "http://localhost:11102",
        "beforeDevCommand": "npm --prefix ../webapp run dev",
        "beforeBuildCommand": "echo 'frontend already built'"
    },
    "app": {
        "windows": [{
            "label": "main",
            "title": "LearnBot MCP",
            "width": 1100,
            "height": 750,
            "minWidth": 700,
            "minHeight": 500,
            "url": "/",
            "center": true
        }],
        "security": { "csp": null }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.png"],
        "resources": [
            "resources/learnbot-mcp-backend.exe",
            "../.env.example"
        ],
        "windows": {
            "webviewInstallMode": { "type": "skip" },
            "nsis": {
                "installMode": "currentUser",
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    }
}
