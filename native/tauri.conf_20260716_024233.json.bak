{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "LearnBot Mascot",
    "version": "0.1.0",
    "identifier": "ai.fleet.learnbot-mascot",
    "build": {
        "frontendDist": "../web_sota/dist",
        "devUrl": "http://localhost:11102",
        "beforeDevCommand": "",
        "beforeBuildCommand": "pwsh -NoProfile -File ../scripts/build-desktop.ps1"
    },
    "app": {
        "windows": [{
            "label": "mascot",
            "title": "Miko-chan",
            "width": 320,
            "height": 420,
            "decorations": false,
            "transparent": true,
            "alwaysOnTop": true,
            "resizable": false,
            "url": "/mascot.html"
        }],
        "security": { "csp": null }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.png"]
    }
}
